                  "    pm.expect(jsonData.data).to.have.property(\"avatar\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"User ID is 2\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
